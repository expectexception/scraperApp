# Copy to .env and update values
DEBUG=1
SECRET_KEY=scraper-service-dev-key

# Database engine: mongodb (default), postgresql, sqlite
DATABASE_ENGINE=mongodb

# MongoDB (recommended: same DB used by backend)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_NAME=aeroops_db

# PostgreSQL fallback (used only when DATABASE_ENGINE=postgresql)
DB_NAME=aeroops_db
DB_USER=aeroops_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

DJANGO_TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Dashboard API auth
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me

# React frontend origin (for CORS)
FRONTEND_URL=http://localhost:8501

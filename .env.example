# Copy to .env and update values
DEBUG=1
SECRET_KEY=scraper-service-dev-key

# Database engine: mongodb (default), postgresql, sqlite
DATABASE_ENGINE=mongodb

# MongoDB (recommended: same DB used by backend)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_NAME=aeroops_db
# Set different DB for testing on same Mongo URI
MONGODB_TEST_NAME=aeroops_test_db

# PostgreSQL fallback (used only when DATABASE_ENGINE=postgresql)
DB_NAME=aeroops_db
DB_USER=aeroops_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

DJANGO_TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_DEFAULT_QUEUE=scrapers
CELERY_TASK_TIME_LIMIT=7200
CELERY_TASK_SOFT_TIME_LIMIT=6900
SCRAPER_EVENT_CHANNEL=scraper.events
REALTIME_URL=http://localhost:8010

# Dashboard API auth
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me

# React frontend origin (for CORS)
FRONTEND_URL=http://localhost:8501
